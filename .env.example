# ─────────────────────────────────────────────────────────────
# Viljetech Platform — Backend environment variables
# Copy to `.env` and fill in local values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development                  # development | production | test
PORT=3001
LOG_LEVEL=debug                       # trace | debug | info | warn | error | fatal

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/viljetech

# JWT — plan-aligned TTLs (access 8h / refresh 5d)
JWT_SECRET=change-me-use-a-long-random-string
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change-me-use-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=5d

# MFA — base64-encoded 32-byte key used to AES-256-GCM encrypt TOTP secrets at rest.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=change-me-base64-32-bytes

# Issuer shown in authenticator apps (otpauth URL).
MFA_ISSUER=Viljetech

# Password reset — used to construct the link sent in reset emails.
# Final URL = ${APP_BASE_URL}${PASSWORD_RESET_URL_PATH}?token=<opaque>
APP_BASE_URL=http://localhost:5173
PASSWORD_RESET_URL_PATH=/reset-password

# ─────────────────────────────────────────────────────────────
# Azure Blob Storage — task attachments (Step 21) + profile photos (Step 22)
# All containers MUST be private. The API mints short-lived SAS tokens for
# upload + download; no public URLs are ever stored.
#
# Auth — provide ONE of the following:
#   1. AZURE_STORAGE_CONNECTION_STRING (preferred; one secret to rotate)
#   2. AZURE_STORAGE_ACCOUNT_NAME + AZURE_STORAGE_ACCOUNT_KEY
#
# Both flavours require the account *key* (not just a SAS or managed identity)
# because SAS minting is performed server-side.
# ─────────────────────────────────────────────────────────────
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=

# Container the task-attachments service writes to. Must already exist; the
# server does not auto-create production containers. Default matches
# Data_Model.md §5.6.
AZURE_BLOB_TASK_ATTACHMENTS_CONTAINER=task-attachments

# Container for user profile photos (Step 22). Same auth as task attachments;
# create the container ahead of time and keep it private — the API mints
# read SAS URLs on demand.
AZURE_BLOB_PROFILE_PHOTOS_CONTAINER=profile-photos

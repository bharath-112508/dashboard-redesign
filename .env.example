# ─────────────────────────────────────────────────────────────
# Viljetech Platform — Backend environment variables
# Copy to `.env` and fill in local values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development                  # development | production | test
PORT=3001
LOG_LEVEL=debug                       # trace | debug | info | warn | error | fatal

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/viljetech

# JWT — plan-aligned TTLs (access 8h / refresh 5d)
JWT_SECRET=change-me-use-a-long-random-string
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change-me-use-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=5d

# MFA — base64-encoded 32-byte key used to AES-256-GCM encrypt TOTP secrets at rest.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=change-me-base64-32-bytes

# Issuer shown in authenticator apps (otpauth URL).
MFA_ISSUER=Viljetech

# Password reset — used to construct the link sent in reset emails.
# Final URL = ${APP_BASE_URL}${PASSWORD_RESET_URL_PATH}?token=<opaque>
APP_BASE_URL=http://localhost:5173
PASSWORD_RESET_URL_PATH=/reset-password
